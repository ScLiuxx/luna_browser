<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- A browser must be able to open legacy http sites, but never silently
         downgrade https traffic. Certificate validation remains enforced. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
